# Telegram Server Dash - Configuration
# Installed as /etc/telegram-server-dash/config.yaml by setup.sh.
# Secrets belong in /etc/telegram-server-dash/telegram-server-dash.env.

servers:
  - name: local-vps
    group: production
    description: "VPS host running Telegram Server Dash"
    enabled: true
    transport: local
    monitor_interval: 30

monitoring:
  sample_interval: 30
  retention_hours: 168

alerts:
  cpu_threshold: 90
  ram_threshold: 85
  disk_threshold: 80
  disk_warning_percent: 70
  swap_warning_percent: 50
