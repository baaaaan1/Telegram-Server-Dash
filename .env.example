# Native production configuration written by setup.sh
# NEVER commit the populated environment file to version control.

# Required: Your Telegram bot token from @BotFather
BOT_TOKEN=your:bot:token:here

# Admin user IDs (comma-separated for multiple admins).
# Bind an account to its @username to require both ID and username:
#   ADMIN_USER_IDS=123456789:myusername,987654321
ADMIN_USER_IDS=123456789

# Optional extra whitelists (comma-separated, same ID:username format)
# OPERATOR_USER_IDS=
# VIEWER_USER_IDS=

# Require every whitelisted ID to have a username binding (1/true to enable).
# The service refuses to start when an ID has no binding while this is on.
# STRICT_USERNAME_MATCH=0

# Chat ID for audit log copies (optional)
LOG_CHAT_ID=

# Initial critical-action PIN (4-8 digits). Users can change it with /pin;
# the stored PBKDF2 hash in SQLite then takes precedence.
# TSD_PIN=
# PIN_TTL_SECONDS=300
# AUTH_MAX_ATTEMPTS=5
# AUTH_LOCKOUT_SECONDS=900
# RATE_LIMIT_PER_MINUTE=30

# Runtime environment
ENV=production

# Persistent SQLite database
DATABASE_PATH=/var/lib/telegram-server-dash/bot.db

# Server registry configuration
TSD_CONFIG=/etc/telegram-server-dash/config.yaml
