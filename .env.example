# .env - Bot configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# Required: Your Telegram bot token from @BotFather
BOT_TOKEN=your:bot:token:here

# Admin user IDs (comma-separated for multiple admins)
ADMIN_USER_IDS=123456789

# Chat ID for log notifications (optional)
LOG_CHAT_ID=

# Environment: dev, staging, production
ENV=dev

# Database path (relative to /app/data in container)
DATABASE_PATH=data/bot.db

# Optional: Config file path override
# TSD_CONFIG=config/config.yaml

# Webhook settings (for production deployments)
# WEBHOOK_BASE_URL=https://your-domain.com
# WEBHOOK_SECRET_TOKEN=your-secret-token