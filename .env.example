# Native production configuration written by setup.sh
# NEVER commit the populated environment file to version control.

# Required: Your Telegram bot token from @BotFather
BOT_TOKEN=your:bot:token:here

# Admin user IDs (comma-separated for multiple admins)
ADMIN_USER_IDS=123456789

# Chat ID for log notifications (optional)
LOG_CHAT_ID=

# Runtime environment
ENV=production

# Persistent SQLite database
DATABASE_PATH=/var/lib/telegram-server-dash/bot.db

# Server registry configuration
TSD_CONFIG=/etc/telegram-server-dash/config.yaml
